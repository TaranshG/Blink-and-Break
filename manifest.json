{
  "manifest_version": 3,
  "name": "BreakChime",
  "short_name": "BreakChime",
  "description": "BreakChime helps protect your eyes with gentle 20-20-20 reminders",
  "version": "1.0.4",
  "minimum_chrome_version": "110",
  "permissions": [
    "alarms",
    "notifications",
    "storage",
    "offscreen"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "BreakChime"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
